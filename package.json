{
  "name": "ai-os-new",
  "private": true,
  "version": "4.5.0",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -b && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:no-tsc": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "fix:unused": "npx tsx scripts/fix-unused.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "proxy": "node scripts/cors-proxy.mjs",
    "sync-server": "node server/sync-server.mjs",
    "dev:shared": "node server/run-dev.mjs",
    "preview": "vite preview",
    "check:circular-kernel": "madge --circular --extensions ts --ts-config tsconfig.json src/kernel/ --exit-code 1",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@orama/orama": "^3.1.18",
    "@react-aria/focus": "^3.22.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@xyflow/react": "^12.10.2",
    "dexie": "^4.4.2",
    "dompurify": "^3.2.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "meriyah": "^7.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^2.15.0",
    "sql.js": "^1.14.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "esbuild": "0.28.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.7",
    "madge": "^8.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
