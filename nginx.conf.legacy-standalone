# ⚠️  LEGACY — NOT USED BY DOCKER
# This file is kept for reference only. Docker uses docker/nginx.conf (HTTP)
# or docker/nginx-ssl.conf (HTTPS/TLS), NOT this file.
#
# This standalone config was for direct nginx installation (no Docker).
# If mounted, nginx-unprivileged will fail to bind privileged ports 80/443.
# Rename this to nginx.conf.standalone if you need a bare-metal reference.

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name _;
